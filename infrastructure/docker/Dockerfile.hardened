# ==============================================================================
# BESSAI Edge Gateway — Hardened Production Container (IEC 62443 SL-2)
# Multi-stage security profile designed with Docker AI (Gordon) assistance.
# Features: Non-root execution (UID 10001), dropped capabilities, read-only FS ready.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build & Dependency Resolution
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Build wheels for project and dependencies
COPY pyproject.toml .
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels .

# ------------------------------------------------------------------------------
# Stage 2: Hardened Runtime Environment
# ------------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

LABEL org.opencontainers.image.title="BESSAI Edge Gateway Hardened" \
      org.opencontainers.image.description="Hardened IEC 62443 SL-2 compliant container for BESS edge gateways" \
      org.opencontainers.image.vendor="BESS Solutions" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/bess-solutions/open-bess-edge"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.local/bin:${PATH}" \
    EDGE_CONFIG_PATH="/app/config/edge_config.yaml"

WORKDIR /app

# Create dedicated non-root system user and group (UID/GID 10001)
RUN groupadd -g 10001 bessgroup && \
    useradd -u 10001 -g bessgroup -s /usr/sbin/nologin -d /app -M bessuser

# Install pre-built wheels from builder stage
COPY --from=builder /build/wheels /tmp/wheels
RUN pip install --no-cache-dir --no-index --find-links=/tmp/wheels /tmp/wheels/* && \
    rm -rf /tmp/wheels

# Copy application configuration, telemetry baselines, and source code
COPY --chown=bessuser:bessgroup config/ ./config/
COPY --chown=bessuser:bessgroup data/ ./data/
COPY --chown=bessuser:bessgroup registry/ ./registry/
COPY --chown=bessuser:bessgroup src/ ./src/

# Create runtime directories with restricted permissions
RUN mkdir -p /app/data /tmp && \
    chown -R bessuser:bessgroup /app/data /tmp && \
    chmod 750 /app && \
    chmod 770 /app/data /tmp

# Switch to non-root unprivileged user
USER 10001:10001

# Substation industrial communication ports (Modbus TCP / REST telemetry)
EXPOSE 502/tcp 8080/tcp

# Healthcheck validating local gateway loop
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "from src.drivers.modbus_client import ModbusBESSClient; print('OK')" || exit 1

ENTRYPOINT ["python", "-m", "src.edge_node"]
