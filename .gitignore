# =============================================================================
# Open BESS Edge — .gitignore (Production Industrial Standard)
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.installed.cfg
*.pyd

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
test_errors.txt
tests_output.txt
*_results.txt

# Binaries, Archives & Large Artifacts
*.zip
*.tar.gz
*.tgz
*.exe
*.bin
*.dll
*.so
*.dylib
arduino_cli_bin/

# Data Dumps & CSV Benchmarks
*.csv
locust_results_*

# Scratch, Debug & Temporary Scripts
scratch_*.py
brute_force_modbus.py
reskin.py
demo.ps1
demo.sh
launch_api.ps1

# Hosting & Server Artifacts
.cpanel.yml

# IDE & Swarm Internal Directories
.agent/
.clusterfuzzlite/
.idea/
.vscode/
*.swp
*.swo

# Environment Variables
.env
.env.*
!.env.example
